# Copy to /etc/callback.env on the server (chmod 600). Never commit the real file.

# Claude API key from https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=

# Model for all AI features. The app maps quick/default/complex to effort low/medium/high.
CLAUDE_MODEL=claude-opus-5-5

# Testers must enter this code before AI features work. Leave empty to open the app to everyone.
ACCESS_CODE=

# Unlocks your usage view: open https://YOUR-DOMAIN/#admin=THIS-TOKEN once in your browser.
ADMIN_TOKEN=

# Safety limits against runaway costs.
DAILY_LIMIT=2000
PER_IP_HOURLY=120

PORT=8080
HOST=127.0.0.1
