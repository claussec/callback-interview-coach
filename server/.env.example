# Copy to /etc/callback.env on the server (chmod 600). Never commit the real file.

# Claude API key from https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=

# Which model does which job is set in server.mjs (DEFAULT_ROUTES): scorecards on Opus 5.5,
# interviewer turns on Sonnet 5.5, small extraction jobs on Haiku 5.5. Change single tasks:
#   ROUTES={"turn":{"model":"claude-opus-5-5"},"hint":{"model":"claude-sonnet-5-5"}}
# or force one model for everything:
#   CLAUDE_MODEL=claude-opus-5-5
ROUTES=
CLAUDE_MODEL=

# Testers must enter this code before AI features work. Leave empty to open the app to everyone.
ACCESS_CODE=

# Unlocks your usage view: open https://YOUR-DOMAIN/#admin=THIS-TOKEN once in your browser.
ADMIN_TOKEN=

# Safety limits against runaway costs.
DAILY_LIMIT=2000
PER_IP_HOURLY=120

PORT=8080
HOST=127.0.0.1
